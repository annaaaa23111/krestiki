using System;

namespace TicTacToe
{
    class Program
    {
        static char[,] board = new char[3, 3];   
        static char player = 'X';               
        static int moves = 0;                   

        static void Main()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;

            do
            {
                StartGame();          

                while (true)
                {
                    DrawBoard();
                    Console.WriteLine("Ход игрока " + player);
                    MakeMove();       // ввод и проверка хода
                    moves++;

                    if (IsWin(player))            
                    {
                        DrawBoard();
                        Console.WriteLine("Победил игрок " + player + "!");
                        break;
                    }
                    if (moves == 9)               
                    {
                        DrawBoard();
                        Console.WriteLine("Ничья!");
                        break;
                    }

                    SwitchPlayer();   // смена игрока
                }

                Console.Write("Сыграть ещё раз? (д/н): ");
            }
            while (Console.ReadLine() != "н");    
        }

        static void MakeMove()
        {
            int row, col;
            while (true)
            {
                Console.Write("Строка (0-2): ");
                string r = Console.ReadLine();
                Console.Write("Столбец (0-2): ");
                string c = Console.ReadLine();

                if (!int.TryParse(r, out row) || !int.TryParse(c, out col))
                {
                    Console.WriteLine("Ошибка: введите числа!");
                    continue;
                }
                if (row < 0 || row > 2 || col < 0 || col > 2)
                {
                    Console.WriteLine("Ошибка: числа от 0 до 2!");
                    continue;
                }
                if (board[row, col] != ' ')
                {
                    Console.WriteLine("Ошибка: клетка занята!");
                    continue;
                }

                board[row, col] = player;
                break;
            }
        }

        static void SwitchPlayer()
        {
            if (player == 'X') player = 'O';
            else player = 'X';
        }

        static bool IsWin(char p)
        {
            for (int i = 0; i < 3; i++)
                if (board[i, 0] == p && board[i, 1] == p && board[i, 2] == p)
                    return true;

            for (int j = 0; j < 3; j++)
                if (board[0, j] == p && board[1, j] == p && board[2, j] == p)
                    return true;

            // диагонали
            if (board[0, 0] == p && board[1, 1] == p && board[2, 2] == p) return true;
            if (board[0, 2] == p && board[1, 1] == p && board[2, 0] == p) return true;

            return false;
        }

        static void StartGame()
        {
            for (int i = 0; i < 3; i++)
                for (int j = 0; j < 3; j++)
                    board[i, j] = ' ';

            player = 'X';
            moves = 0;
            Console.Clear();
            Console.WriteLine("=== КРЕСТИКИ-НОЛИКИ ===\n");
        }

        static void DrawBoard()
        {
            Console.WriteLine();
            Console.WriteLine("     0   1   2");
            Console.WriteLine("   ┌───┬───┬───┐");
            for (int i = 0; i < 3; i++)
            {
                Console.Write(" " + i + " │");
                for (int j = 0; j < 3; j++)
                {
                    Console.Write(" " + board[i, j] + " │");
                }
                Console.WriteLine();
                if (i < 2) Console.WriteLine("   ├───┼───┼───┤");
            }
            Console.WriteLine("   └───┴───┴───┘");
            Console.WriteLine();
        }
    }
}
